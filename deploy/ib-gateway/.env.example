# IB Gateway（ペーパー口座）の認証情報。
#
#   cp .env.example .env && chmod 600 .env
#
# **`.env` には平文のパスワードが入る。** .gitignore の `.env` で除外されるが、
# パーミッションは自分で絞ること（SSHは鍵認証のみにする）。
#
# **同じ認証情報でMacとVPSの同時ログインはできない。** 後からのログインが先の
# セッションを切るため、並行稼働ではなく切り替えとして移行すること
# （deploy/README.md「7. 移行後のmacOS側」）。

# ペーパー口座のユーザー名・パスワード。
# **実資金口座の認証情報を書いてはならない**——docker-compose.yml は
# TRADING_MODE=paper で固定しているが、それは口座の種別を選ぶ設定であって
# 実資金の認証情報を無害にするものではない。
TWS_USERID=
TWS_PASSWORD=

# VNC（Order Presets の確認に使う）のパスワード。
# 空にするとVNCサーバ自体が起動しない。ポートは 127.0.0.1 に束ねてあり、
# 閲覧は `ssh -L 5900:127.0.0.1:5900 <user>@<vps>` 経由で行う。
VNC_SERVER_PASSWORD=
