# cp .env.example .env して書き換える。.env はGit管理外（リポジトリの .gitignore が
# 階層を問わず .env を無視する）。chmod 600 しておくこと——平文のパスワードが入る。
#
# **ペーパー口座の認証情報を書く。** ライブとは別のユーザー名・パスワードである
# （IBKRのアカウント管理でペーパー用のログイン情報を確認できる）。
# ライブの認証情報を書くと、TRADING_MODE=paper でもログイン先の口座が変わる。
TWS_USERID=
TWS_PASSWORD=

# VNCはGUI設定の確認にだけ使う。SSHトンネル越しに繋ぐので推測されにくい値にする。
VNC_SERVER_PASSWORD=
