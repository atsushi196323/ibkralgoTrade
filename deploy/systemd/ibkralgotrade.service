[Unit]
# 米国市場の寄り付き15分前にBotを起動する（起動時刻はタイマー側）。
Description=IBKR algo trading bot (US swing)

# 失敗が続いたら再試行を打ち切り、failed状態で止まる。
# start_bot.sh は取引日を判定できなかったとき（インタープリタのパス違い等）に
# 終了コード1を返すので、Restart=on-failure と組み合わせると**設定を直すまで
# 60秒ごとに再起動し続ける**。打ち切っておけば `systemctl --user list-units --failed`
# に残り、journalも1日ぶん埋まらない。市場が閉じている間の接続失敗で
# main.py が落ちるわけではない（自前で再試行し続ける）ので、この回数で足りる。
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/ibkralgoTrade

# .env の読み込み(python-dotenvはcwd基準)と logs/ の出力先を
# リポジトリ直下に固定するため WorkingDirectory は必須。
#
# インタープリタの実体を渡すのは、systemdがログインシェルを経由せず
# PATHにpyenv/venvが入らないため（launchd側と同じ理由）。
Environment=IBKRALGO_PYTHON=%h/ibkralgoTrade/.venv/bin/python

# main.pyを直接起動せずラッパーを挟むのは、**米国市場の祝日を
# OnCalendar では表現できない**ためである。除外の仕組みも祝日カレンダーも
# 無いので、判定は起動直前に scripts/start_bot.sh が行い、休場日は
# プロセスを起こさない（休場日に起動しても実害は無いが、7時間ぶんの
# 待機ログとGatewayへの接続試行が積まれ、翌朝のサマリが読めなくなる）。
ExecStart=/bin/bash %h/ibkralgoTrade/scripts/start_bot.sh

# 停止は after_close.sh が systemctl stop で行う。既定の KillMode=control-group
# により SIGTERM が main.py へ届き、_raise_keyboard_interrupt_on_sigterm が
# KeyboardInterrupt へ変換して disconnect_async() まで通す。
# disconnect に余裕を持たせるため、SIGKILLまでの猶予を既定より延ばす。
TimeoutStopSec=30

# 落ちたら再起動するが、間隔を空ける。main.py 自身が ConnectionError を
# 捕捉して再試行し続ける設計なので、ここで即時再起動を繰り返す必要は無い。
Restart=on-failure
RestartSec=60

# configure_logging()が効く前(起動時の例外・依存関係の解決失敗など)と、
# start_bot.sh 自身の出力(祝日判定・取引日を判定できなかったERROR)は
# logs/bot.log に残らない。
#
# **journalではなく logs/ 配下のファイルへ出す。** journalに置くと、あとで
# 手元へ持ってきて調べるときに `logs/` を同期するだけでは拾えず、
# journalctl を別途取り出す必要がある（`scripts/fetch_vps_logs.sh` は
# logs/ をまとめて同期する）。launchd側が logs/launchd.out へ出しているのと
# 同じ扱いに揃える——2026-08-10にジョブが動かなかった件は、この出力が
# ファイルに残っていたから切り分けられた。
#
# 標準エラーが端末でないため configure_logging はコンソール出力を行わず、
# bot.log と同じ内容がここへ二重に積まれることはない（CLAUDE.md「3.」）。
StandardOutput=append:%h/ibkralgoTrade/logs/systemd.out
StandardError=append:%h/ibkralgoTrade/logs/systemd.err
