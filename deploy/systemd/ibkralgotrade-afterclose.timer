[Unit]
Description=Wrap up the US trading day (06:05 JST)

[Timer]
# 06:05 JST は、夏時間で17:05 ET・冬時間で16:05 ET となり、年間を通じて
# **必ず引け(16:00 ET)の後**になる。05:05にすると冬時間の間は15:05 ET＝
# ザラ場の最中にBotを落とし、確定していない売買代金でその日の順位を記録する
# ことになる。
#
# 曜日は火〜土。起動側(月〜金)と**1日ずれる**のは、金曜22:15に始まった
# セッションを閉じるのが土曜06:05のジョブだからである。締め側を月〜金に
# すると金曜のセッションが停止されず週末まで走り続ける。日曜・月曜の06:05を
# 外しているのは、それぞれ土曜・日曜の引け後にあたり取引が無いためである。
OnCalendar=Tue..Sat 06:05 Asia/Tokyo

# 締めは「その時刻の状態」を記録するものなので、後から遅れて実行しても
# 意味を持たない（起動側と同じ理由）。
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
