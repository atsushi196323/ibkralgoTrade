# IB Gateway / TWS への接続設定。`.env` としてコピーして使う（`.env` はGit管理外）。
#
# **本番用ポート(7496 / 4001)を書いてはならない。** 実発注はペーパー口座に限る
# 制約があり、`ensure_orders_are_paper_only` が起動時に許可リストで弾く。
# 加えて `ensure_account_is_paper` が、ブローカーの返す口座番号（DU / DF で
# 始まる）まで確認する——IBCの `OverrideTwsApiPort` はモードと無関係にポートを
# 決められるので、ポートだけでは実口座への発注を防げない。

IBKR_HOST=127.0.0.1

# ペーパー: TWS=7497 / IB Gateway=4002
IBKR_PORT=4002

# 他のプロセスと重複させないこと（同じIDで同時に繋ぐと接続そのものが弾かれる）。
IBKR_CLIENT_ID=1

# 1=LIVE / 2=FROZEN / 3=DELAYED / 4=DELAYED_FROZEN
# 既定が遅延(3)なのは、ペーパー口座がリアルタイムの購読契約を持たないことが
# 多いため。無料のリアルタイム配信(Cboe One / IEX)は非連結でNBBOを示さないので、
# 「遅延の上位互換」として入れてはならない（CLAUDE.md 参照）。
IBKR_MARKET_DATA_TYPE=3
