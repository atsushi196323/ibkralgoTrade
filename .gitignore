.env
__pycache__/
*.pyc
.venv/
venv/

# 稼働時の出力（稼働ログ・取引履歴・ポジション状態）。実際の取引記録なのでコミットしない。
# 手元に退避したログ（logs_194k_20260731/ のような命名）も取りこぼさないよう
# 接頭辞で一致させる。`logs/` だけでは退避ディレクトリが未追跡のまま残り、
# `git add -A` で実際のポジション記録を混入させうる。
logs*/

# 検証用に取得したヒストリカルバー(scripts/fetch_bars.py)。再取得できるのでコミットしない。
bars/

# IB Gatewayの設定（VPSのDocker運用でvolumeとしてマウントする先）。口座情報を含む。
deploy/ib-gateway/tws_settings/
